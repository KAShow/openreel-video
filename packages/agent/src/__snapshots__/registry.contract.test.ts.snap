  {
    "description": "Update an existing main-timeline clip's static transform. position is a pixel offset from canvas center; scale uses 1 = 100%; rotation is degrees; opacity is 0..1. Partial nested updates are safely merged, so {scale:{x:1.2,y:1.2}} performs a 120% zoom without resetting position.",
    "destructive": false,
    "domain": "transform",
    "expensive": false,
    "inputSchema": {
      "additionalProperties": true,
      "properties": {
        "clipId": {
          "type": "string",
        },
        "transform": {
          "additionalProperties": true,
          "properties": {
            "anchor": {
              "additionalProperties": true,
              "properties": {
                "x": {
                  "type": "number",
                },
                "y": {
                  "type": "number",
                },
              },
              "required": [],
              "type": "object",
            },
            "crop": {
              "additionalProperties": true,
              "properties": {
                "height": {
                  "type": "number",
                },
                "width": {
                  "type": "number",
                },
                "x": {
                  "type": "number",
                },
                "y": {
                  "type": "number",
                },
              },
              "required": [],
              "type": "object",
            },
            "fitMode": {
              "enum": [
                "contain",
                "cover",
                "stretch",
                "none",
              ],
              "type": "string",
            },
            "opacity": {
              "type": "number",
            },
            "position": {
              "additionalProperties": true,
              "properties": {
                "x": {
                  "type": "number",
                },
                "y": {
                  "type": "number",
                },
              },
              "required": [],
              "type": "object",
            },
            "rotation": {
              "type": "number",
            },
            "scale": {
              "additionalProperties": true,
              "properties": {
                "x": {
                  "type": "number",
                },
                "y": {
                  "type": "number",
                },
              },
              "required": [],
              "type": "object",
            },
          },
          "required": [],
          "type": "object",
        },
      },
      "required": [
        "clipId",
        "transform",
      ],
      "type": "object",
    },
    "name": "set_clip_transform",
    "readOnly": false,
    "title": "Transform clip",
